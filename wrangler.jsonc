{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rfanelli",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-17",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // next-themes serializes its initializer into an inline browser script.
  // Preserving function names would inject an unavailable __name helper.
  "keep_names": false,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "rfanelli",
    },
  ],
  "images": {
    "binding": "IMAGES",
  },
}
